---
import { brand, brandCssVariablesStyle } from "@/data/brand";
import { getMenuCategoryLabel } from "@/data/product-categories";
import {
  getActiveMenuProductById,
  listActiveMenuProducts,
} from "@/lib/db/products";
import {
  ADICIONALES_CATEGORY,
  productUsesAdicionales,
} from "@/lib/orders/item-extras";
import {
  getApplicableModifierGroups,
  getDefaultSelections,
} from "@/lib/orders/item-preferences";
import { formatCop } from "@/lib/utils/currency";
import { getProxiedImageUrl } from "@/lib/utils/images";
import { getExchangeRates } from "@/lib/db/exchange-rates";
import { isStoreOpen } from "@/lib/utils/schedule";
import CartDrawer from "@/components/cart/CartDrawer";
import CurrencySwitch from "@/components/currency/CurrencySwitch.astro";
import "@/styles/global.css";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

const product = await getActiveMenuProductById(id);

if (!product) {
  return Astro.redirect("/");
}

const productImageUrl = getProxiedImageUrl(product.image_url);

const [allProducts, exchangeRates] = await Promise.all([
  listActiveMenuProducts(),
  getExchangeRates(),
]);

const storeIsOpen = isStoreOpen(
  brand.contact.openingHour,
  brand.contact.closingHour,
);

const adicionalProducts = allProducts
  .filter((item) => item.category === ADICIONALES_CATEGORY)
  .sort((a, b) => a.name.localeCompare(b.name));

const modifierGroups = getApplicableModifierGroups(product.category);
const defaultSelections = getDefaultSelections(product.category);
const usesAdicionales = productUsesAdicionales(product.category);

const singleGroupIds = modifierGroups
  .filter((group) => group.mode === "single")
  .map((group) => group.id);

const multipleGroupIds = modifierGroups
  .filter((group) => group.mode === "multiple")
  .map((group) => group.id);

const categoryLabel = getMenuCategoryLabel(product.category);
const title = `${product.name} | ${brand.name}`;

const isOutOfStock = Boolean(
  product.has_inventory &&
  product.stock !== null &&
  product.stock !== undefined &&
  product.stock <= 0,
);
const hasInventory = Boolean(
  product.has_inventory &&
  product.stock !== null &&
  product.stock !== undefined,
);
const maxStock = hasInventory ? product.stock! : undefined;
---

<!doctype html>
<html lang={brand.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={product.description ?? `${product.name} — ${brand.name}`}
    />
    <link rel="icon" type="image/webp" href={brand.assets.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global set:html={brandCssVariablesStyle()}></style>
  </head>
  <body>
    <!-- AMBIENT BACKGROUND GLOW -->
    <div class="prod-bg-glow" aria-hidden="true"></div>

    <div class="prod-page">
      <!-- TOP NAVIGATION BAR -->
      <header class="prod-nav">
        <a href="/" class="prod-nav__back" aria-label="Volver al menú">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>Menú principal</span>
        </a>

        <div class="prod-nav__actions">
          <CurrencySwitch rates={exchangeRates} class="prod-nav__currency" />

          <a href="/pedido" class="prod-nav__cart" aria-label="Ver mi pedido">
            <span class="prod-nav__cart-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
                ></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </span>
            <span class="prod-nav__cart-label">Mi pedido</span>
            <span class="prod-nav__cart-badge" id="nav-cart-badge" hidden
              >0</span
            >
          </a>
        </div>
      </header>

      <!-- MAIN PRODUCT LAYOUT -->
      <main class="prod-layout">
        <!-- LEFT: VISUAL MEDIA -->
        <section class="prod-media-col">
          <div class="prod-media-card">
            <div class="prod-media-container">
              {
                productImageUrl ? (
                  <img
                    src={productImageUrl}
                    alt={product.name}
                    class="prod-media-img"
                    loading="eager"
                  />
                ) : (
                  <div class="prod-placeholder" aria-hidden="true">
                    <div class="prod-placeholder__bg" />
                    <div class="prod-placeholder__content">
                      <span class="prod-placeholder__letter">
                        {product.name.trim().charAt(0).toUpperCase()}
                      </span>
                      <svg
                        class="prod-placeholder__cutlery"
                        viewBox="0 0 24 24"
                        width="36"
                        height="36"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                        <line x1="6" y1="1" x2="6" y2="4" />
                        <line x1="10" y1="1" x2="10" y2="4" />
                        <line x1="14" y1="1" x2="14" y2="4" />
                      </svg>
                    </div>
                  </div>
                )
              }
              <div class="prod-media-gradient"></div>
              <span class="prod-media-badge">{categoryLabel}</span>
            </div>
          </div>
        </section>

        <!-- RIGHT: PRODUCT DETAILS & CUSTOMIZATION -->
        <section class="prod-details-col">
          <div class="prod-details-card">
            <!-- HEADER INFO -->
            <div class="prod-header">
              <div class="prod-category-tag">{categoryLabel}</div>
              <h1 class="prod-title">{product.name}</h1>
              {
                product.description && (
                  <p class="prod-description">{product.description}</p>
                )
              }
              <div class="prod-price-hero">
                <span class="prod-price-label">Precio base</span>
                <span class="prod-price-val" data-price-cop={product.price}
                  >{formatCop(product.price)}</span
                >
              </div>
            </div>

            <!-- CUSTOMIZATION FORM -->
            <form
              class="prod-form"
              id="product-form"
              data-has-inventory={hasInventory ? "true" : "false"}
              data-stock={hasInventory ? String(maxStock) : ""}
            >
              <!-- QUANTITY STEPPER -->
              <div class="prod-section prod-section--quantity">
                <div class="prod-section__heading">
                  <span class="prod-section__title">Cantidad</span>
                  {
                    isOutOfStock ? (
                      <span class="prod-section__stock-tag prod-section__stock-tag--empty">
                        Agotado en inventario
                      </span>
                    ) : hasInventory && maxStock !== undefined ? (
                      <span class="prod-section__stock-tag">
                        Disponibles: <strong>{maxStock}</strong>{" "}
                        {maxStock === 1 ? "unidad" : "unidades"}
                      </span>
                    ) : (
                      <span class="prod-section__hint">
                        ¿Cuántas unidades deseas?
                      </span>
                    )
                  }
                </div>

                <div class="prod-stepper">
                  <button
                    type="button"
                    class="prod-stepper__btn"
                    id="qty-decrease"
                    aria-label="Disminuir cantidad"
                    disabled={isOutOfStock}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                  <input
                    id="quantity"
                    name="quantity"
                    type="number"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    min={isOutOfStock ? 0 : 1}
                    max={maxStock}
                    step="1"
                    value={isOutOfStock ? 0 : 1}
                    disabled={isOutOfStock}
                    required
                    class="prod-stepper__input"
                    aria-label="Cantidad de unidades"
                  />
                  <button
                    type="button"
                    class="prod-stepper__btn"
                    id="qty-increase"
                    aria-label="Aumentar cantidad"
                    disabled={isOutOfStock ||
                      (hasInventory && maxStock !== undefined && maxStock <= 1)}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- PREFERENCIAS / MODIFIERS -->
              {
                modifierGroups.length > 0 && (
                  <div class="prod-section">
                    <div class="prod-section__heading">
                      <span class="prod-section__title">
                        Personaliza tu preparación
                      </span>
                      <span class="prod-section__hint">
                        Indícanos tus preferencias
                      </span>
                    </div>

                    <div class="prod-modifiers-wrap">
                      {modifierGroups.map((group) => (
                        <div class="prod-mod-group">
                          <div class="prod-mod-group__header">
                            <span class="prod-mod-group__label">
                              {group.label}
                            </span>
                            <span class="prod-mod-group__badge">
                              {group.mode === "single"
                                ? "Elige 1 opción"
                                : "Opcional"}
                            </span>
                          </div>

                          <div
                            class="prod-mod-chips"
                            role={
                              group.mode === "single" ? "radiogroup" : "group"
                            }
                            aria-label={group.label}
                          >
                            {group.options.map((option) => {
                              const isChecked =
                                group.mode === "single"
                                  ? defaultSelections[group.id]?.[0] === option
                                  : (defaultSelections[group.id]?.includes(
                                      option,
                                    ) ?? false);

                              return (
                                <label class="prod-mod-chip">
                                  <input
                                    type={
                                      group.mode === "single"
                                        ? "radio"
                                        : "checkbox"
                                    }
                                    name={group.id}
                                    value={option}
                                    checked={isChecked}
                                    class="prod-mod-chip__input"
                                  />
                                  <span class="prod-mod-chip__box">
                                    <span
                                      class="prod-mod-chip__check"
                                      aria-hidden="true"
                                    >
                                      <svg
                                        viewBox="0 0 20 20"
                                        width="12"
                                        height="12"
                                        fill="currentColor"
                                      >
                                        <path
                                          fill-rule="evenodd"
                                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                          clip-rule="evenodd"
                                        />
                                      </svg>
                                    </span>
                                    <span class="prod-mod-chip__text">
                                      {option}
                                    </span>
                                  </span>
                                </label>
                              );
                            })}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )
              }

              <!-- ADICIONALES (EXTRAS) -->
              {
                usesAdicionales && adicionalProducts.length > 0 && (
                  <div class="prod-section">
                    <div class="prod-section__heading">
                      <span class="prod-section__title">
                        Adicionales sugeridos
                      </span>
                      <span class="prod-section__hint">
                        Personaliza y añade más sabor
                      </span>
                    </div>

                    <div
                      class="prod-extras-grid"
                      role="group"
                      aria-label="Adicionales disponibles"
                    >
                      {adicionalProducts.map((extra) => (
                        <label class="prod-extra-item">
                          <input
                            type="checkbox"
                            name="adicional"
                            value={extra.id}
                            data-price={extra.price}
                            data-name={extra.name}
                            class="prod-extra-item__input"
                          />
                          <div class="prod-extra-item__box">
                            <div
                              class="prod-extra-item__check-wrap"
                              aria-hidden="true"
                            >
                              <span class="prod-extra-item__checkbox">
                                <svg
                                  viewBox="0 0 20 20"
                                  width="12"
                                  height="12"
                                  fill="currentColor"
                                >
                                  <path
                                    fill-rule="evenodd"
                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                    clip-rule="evenodd"
                                  />
                                </svg>
                              </span>
                            </div>
                            <div class="prod-extra-item__info">
                              <span class="prod-extra-item__name">
                                {extra.name}
                              </span>
                            </div>
                            <span
                              class="prod-extra-item__price"
                              data-price-cop={extra.price}
                              data-price-prefix="+"
                            >
                              + {formatCop(extra.price)}
                            </span>
                          </div>
                        </label>
                      ))}
                    </div>
                  </div>
                )
              }

              <!-- SUMMARY & ORDER ACTION -->
              <div class="prod-checkout-card">
                <div class="prod-checkout-summary">
                  <div class="prod-checkout-row">
                    <span class="prod-checkout-label">Total estimado</span>
                    <span class="prod-checkout-total" id="product-total"
                      >{formatCop(product.price)}</span
                    >
                  </div>
                  <span
                    class="prod-checkout-subtext"
                    id="product-summary-detail"
                  >
                    1 unidad • {formatCop(product.price)} base
                  </span>
                </div>

                <div class="prod-cta-group">
                  <button
                    type="submit"
                    class={`prod-submit-btn ${!storeIsOpen ? "prod-submit-btn--closed" : ""} ${isOutOfStock ? "prod-submit-btn--disabled" : ""}`}
                    id="product-submit-btn"
                    disabled={!storeIsOpen || isOutOfStock}
                    title={isOutOfStock
                      ? "Producto agotado en inventario"
                      : !storeIsOpen
                        ? `Pedidos dentro del horario laboral (${brand.contact.openingHour || ""} - ${brand.contact.closingHour || ""})`
                        : undefined}
                  >
                    {
                      isOutOfStock ? (
                        <>
                          <span
                            class="prod-submit-btn__icon"
                            aria-hidden="true"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="20"
                              height="20"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="10" />
                              <line x1="15" y1="9" x2="9" y2="15" />
                              <line x1="9" y1="9" x2="15" y2="15" />
                            </svg>
                          </span>
                          <span class="prod-submit-btn__label">
                            Producto Agotado
                          </span>
                        </>
                      ) : storeIsOpen ? (
                        <>
                          <span
                            class="prod-submit-btn__icon"
                            aria-hidden="true"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="20"
                              height="20"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                              <line x1="3" y1="6" x2="21" y2="6" />
                              <path d="M16 10a4 4 0 0 1-8 0" />
                            </svg>
                          </span>
                          <span class="prod-submit-btn__label">
                            Agregar al pedido
                          </span>
                          <span class="prod-submit-btn__dot">•</span>
                          <span class="prod-submit-btn__price" id="btn-total">
                            {formatCop(product.price)}
                          </span>
                        </>
                      ) : (
                        <>
                          <span
                            class="prod-submit-btn__icon"
                            aria-hidden="true"
                          >
                            <svg
                              viewBox="0 0 24 24"
                              width="20"
                              height="20"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="10" />
                              <polyline points="12 6 12 12 16 14" />
                            </svg>
                          </span>
                          <span class="prod-submit-btn__label">
                            Pedidos dentro del horario laboral
                          </span>
                        </>
                      )
                    }
                  </button>

                  <div
                    class="prod-feedback-toast"
                    id="product-feedback"
                    hidden
                    aria-live="polite"
                  >
                    <span class="prod-feedback-toast__icon">✓</span>
                    <span>¡Agregado con éxito a tu pedido!</span>
                    <a href="/pedido" class="prod-feedback-toast__link"
                      >Ver pedido →</a
                    >
                  </div>
                </div>
              </div>
            </form>
          </div>
        </section>
      </main>
    </div>

    <!-- CARRITO / PEDIDO LATERAL REACT COMPONENT -->
    <CartDrawer
      client:load
      brandName={brand.name}
      brandPhone={brand.contact.phone}
      showFloatingButton={false}
      exchangeRates={exchangeRates}
      openingHour={brand.contact.openingHour}
      closingHour={brand.contact.closingHour}
    />

    <!-- CLIENT CONFIGURATION DATA -->
    <script
      type="application/json"
      id="product-config"
      set:html={JSON.stringify({
        productId: product.id,
        productName: product.name,
        productPrice: product.price,
        productImageUrl: productImageUrl || null,
        singleGroupIds,
        multipleGroupIds,
        exchangeRates,
        isStoreOpen: storeIsOpen,
        hasInventory,
        stock: maxStock ?? null,
      })}
    />

    <!-- CLIENT LOGIC SCRIPT -->
    <script>
      import {
        formatCop,
        formatPriceByCurrency,
        PUBLIC_CURRENCY_STORAGE_KEY,
        CURRENCY_CHANGE_EVENT,
        type PublicCurrency,
      } from "@/lib/utils/currency";
      import {
        addToCart,
        getCartItems,
        notifyCartChanged,
        openCartDrawer,
        CART_STORAGE_KEY,
        CART_EVENT,
      } from "@/lib/cart";

      const configEl = document.getElementById("product-config");
      if (!configEl) throw new Error("Product config missing");
      const {
        productId,
        productName,
        productPrice,
        productImageUrl,
        singleGroupIds,
        multipleGroupIds,
        exchangeRates,
        isStoreOpen = true,
        hasInventory = false,
        stock = null,
      } = JSON.parse(configEl.textContent || "{}") as {
        productId: string;
        productName: string;
        productPrice: number;
        productImageUrl: string | null;
        singleGroupIds: string[];
        multipleGroupIds: string[];
        exchangeRates: { usd_rate: number; bs_rate: number };
        isStoreOpen?: boolean;
        hasInventory?: boolean;
        stock?: number | null;
      };

      const form = document.getElementById(
        "product-form",
      ) as HTMLFormElement | null;
      const quantityInput = document.getElementById(
        "quantity",
      ) as HTMLInputElement | null;
      const btnDecrease = document.getElementById("qty-decrease");
      const btnIncrease = document.getElementById("qty-increase");
      const totalEl = document.getElementById(
        "product-total",
      ) as HTMLElement | null;
      const btnTotalEl = document.getElementById(
        "btn-total",
      ) as HTMLElement | null;
      const summaryDetailEl = document.getElementById(
        "product-summary-detail",
      ) as HTMLElement | null;
      const feedback = document.getElementById(
        "product-feedback",
      ) as HTMLElement | null;
      let feedbackTimeoutId: number | undefined;
      const submitBtn = document.getElementById(
        "product-submit-btn",
      ) as HTMLButtonElement | null;
      const navCartBadge = document.getElementById("nav-cart-badge");

      function updateNavCartBadge() {
        if (!navCartBadge) return;
        try {
          const raw = window.localStorage.getItem(CART_STORAGE_KEY);
          if (!raw) {
            navCartBadge.hidden = true;
            return;
          }
          const items = JSON.parse(raw);
          if (Array.isArray(items) && items.length > 0) {
            const count = items.reduce(
              (acc: number, item: any) => acc + (Number(item.quantity) || 1),
              0,
            );
            navCartBadge.textContent = String(count);
            navCartBadge.hidden = false;
          } else {
            navCartBadge.hidden = true;
          }
        } catch {
          navCartBadge.hidden = true;
        }
      }

      function getSelectedOptions(group: string): string[] {
        const inputs = Array.from(
          form?.querySelectorAll<HTMLInputElement>(
            `input[name="${group}"]:checked`,
          ) ?? [],
        );
        return inputs.map((input) => input.value);
      }

      function getCheckedAdicionales(): Array<{
        id: string;
        name: string;
        price: number;
      }> {
        const inputs = Array.from(
          form?.querySelectorAll<HTMLInputElement>(
            'input[name="adicional"]:checked',
          ) ?? [],
        );
        return inputs.map((input) => ({
          id: input.value,
          name: input.dataset.name ?? "",
          price: Number(input.dataset.price ?? 0),
        }));
      }

      let currentCurrency: PublicCurrency = "COP";
      try {
        const stored = localStorage.getItem(
          PUBLIC_CURRENCY_STORAGE_KEY,
        ) as PublicCurrency | null;
        if (stored === "COP" || stored === "USD" || stored === "BS") {
          currentCurrency = stored;
        }
      } catch {}

      function updateAllPriceLabels() {
        const elements =
          document.querySelectorAll<HTMLElement>("[data-price-cop]");
        elements.forEach((el) => {
          const raw = el.getAttribute("data-price-cop");
          if (!raw) return;
          const priceVal = Number(raw);
          if (!Number.isFinite(priceVal)) return;

          const formatted = formatPriceByCurrency(
            priceVal,
            currentCurrency,
            exchangeRates,
          );
          const hasPlus =
            el.dataset.pricePrefix === "+" ||
            el.textContent?.trim().startsWith("+");
          el.textContent = hasPlus ? `+ ${formatted}` : formatted;
        });
      }

      window.addEventListener(CURRENCY_CHANGE_EVENT, (event: Event) => {
        const customEvent = event as CustomEvent<{ currency: PublicCurrency }>;
        if (customEvent.detail?.currency) {
          currentCurrency = customEvent.detail.currency;
          updateAllPriceLabels();
          recalculate();
        }
      });

      function getValidQuantity(): number {
        const val = Math.floor(Number(quantityInput?.value ?? 1));
        let valid = isNaN(val) || val < 1 ? 1 : val;
        if (hasInventory && stock !== null) {
          valid = Math.min(valid, Math.max(1, stock));
        }
        return valid;
      }

      function recalculate() {
        const raw = Number(quantityInput?.value ?? 1);
        const quantity = isNaN(raw) || raw < 1 ? 1 : Math.floor(raw);
        const extras = getCheckedAdicionales();
        const extrasTotal = extras.reduce((sum, extra) => sum + extra.price, 0);
        const total = (productPrice + extrasTotal) * quantity;
        const formattedTotal = formatPriceByCurrency(
          total,
          currentCurrency,
          exchangeRates,
        );

        if (totalEl) totalEl.textContent = formattedTotal;
        if (btnTotalEl) btnTotalEl.textContent = formattedTotal;

        if (summaryDetailEl) {
          const unitWord = quantity === 1 ? "unidad" : "unidades";
          if (extras.length > 0) {
            summaryDetailEl.textContent = `${quantity} ${unitWord} • Incluye ${extras.length} adicional${extras.length > 1 ? "es" : ""}`;
          } else {
            const formattedBase = formatPriceByCurrency(
              productPrice,
              currentCurrency,
              exchangeRates,
            );
            summaryDetailEl.textContent = `${quantity} ${unitWord} • ${formattedBase} c/u`;
          }
        }
      }

      // Initial price labels update if not COP
      if (currentCurrency !== "COP") {
        updateAllPriceLabels();
        recalculate();
      }

      function setQuantity(nextVal: number) {
        if (!quantityInput) return;
        let next = Math.max(1, Math.floor(nextVal) || 1);
        if (hasInventory && stock !== null) {
          next = Math.min(stock, next);
        }
        quantityInput.value = String(next);
        recalculate();
      }

      // STEPPER LISTENERS
      btnDecrease?.addEventListener("click", () => {
        const current = getValidQuantity();
        setQuantity(current - 1);
      });

      btnIncrease?.addEventListener("click", () => {
        const current = getValidQuantity();
        if (hasInventory && stock !== null && current >= stock) {
          return;
        }
        setQuantity(current + 1);
      });

      quantityInput?.addEventListener("input", () => {
        const raw = Number(quantityInput.value);
        if (!isNaN(raw) && raw > 0) {
          if (hasInventory && stock !== null && raw > stock) {
            quantityInput.value = String(stock);
          }
          recalculate();
        }
      });

      quantityInput?.addEventListener("blur", () => {
        const current = getValidQuantity();
        quantityInput.value = String(current);
        recalculate();
      });

      quantityInput?.addEventListener("change", () => {
        const current = getValidQuantity();
        quantityInput.value = String(current);
        recalculate();
      });

      // FORM LISTENERS
      if (form) {
        form.addEventListener("input", (event) => {
          const target = event.target as HTMLElement | null;
          const input = target instanceof HTMLInputElement ? target : null;
          if (!input) return;

          if (singleGroupIds.includes(input.name)) {
            const groupInputs = form.querySelectorAll<HTMLInputElement>(
              `input[name="${input.name}"]`,
            );
            groupInputs.forEach((candidate) => {
              if (candidate !== input) candidate.checked = false;
            });
          }

          recalculate();
        });

        form.addEventListener("submit", (event) => {
          event.preventDefault();

          if (!isStoreOpen || (hasInventory && stock !== null && stock <= 0)) {
            return;
          }

          const quantity = getValidQuantity();
          if (quantity < 1) return;

          const cartItems = getCartItems();
          const inCartForThis = cartItems
            .filter((it) => it.productId === productId)
            .reduce((sum, it) => sum + it.quantity, 0);

          if (hasInventory && stock !== null) {
            if (stock <= 0) {
              if (feedback) {
                feedback.textContent =
                  "Este producto está agotado en inventario.";
                feedback.hidden = false;
              }
              return;
            }
            if (inCartForThis + quantity > stock) {
              const maxCanAdd = Math.max(0, stock - inCartForThis);
              if (feedback) {
                feedback.textContent =
                  maxCanAdd <= 0
                    ? `Ya tienes el máximo disponible (${stock}) en tu pedido.`
                    : `Solo puedes agregar ${maxCanAdd} más (stock: ${stock}, en carrito: ${inCartForThis}).`;
                feedback.hidden = false;
                window.clearTimeout(feedbackTimeoutId);
                feedbackTimeoutId = window.setTimeout(() => {
                  feedback.hidden = true;
                }, 4000);
              }
              return;
            }
          }

          const notes: string[] = [];

          for (const groupId of multipleGroupIds) {
            const selected = getSelectedOptions(groupId);
            if (selected.length > 0) notes.push(selected.join(", "));
          }

          for (const groupId of singleGroupIds) {
            const selected = getSelectedOptions(groupId);
            if (selected.length > 0) notes.push(selected.join(", "));
          }

          try {
            addToCart({
              productId,
              name: productName,
              imageUrl: productImageUrl,
              basePrice: productPrice,
              quantity,
              notes: notes.join(", "),
              adicionales: getCheckedAdicionales(),
              hasInventory,
              stock,
            });
            notifyCartChanged();
            updateNavCartBadge();
            openCartDrawer();

            // Smooth feedback & micro-interaction
            if (submitBtn) {
              submitBtn.classList.add("is-success");
              window.setTimeout(() => {
                submitBtn.classList.remove("is-success");
              }, 600);
            }

            if (feedback) {
              if (feedbackTimeoutId) {
                window.clearTimeout(feedbackTimeoutId);
              }
              feedback.hidden = false;
              feedbackTimeoutId = window.setTimeout(() => {
                feedback.hidden = true;
              }, 4000);
            }
          } catch (err) {
            if (feedback) {
              feedback.textContent =
                err instanceof Error
                  ? err.message
                  : "No se pudo agregar al carrito";
              feedback.hidden = false;
              window.clearTimeout(feedbackTimeoutId);
              feedbackTimeoutId = window.setTimeout(() => {
                feedback.hidden = true;
              }, 4000);
            }
          }
        });
      }

      // CART BADGE LISTENER
      window.addEventListener(CART_EVENT, updateNavCartBadge);
      window.addEventListener("storage", updateNavCartBadge);
      updateNavCartBadge();
      recalculate();
    </script>
  </body>
</html>

