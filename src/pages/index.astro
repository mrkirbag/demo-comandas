---
import { brand, brandCssVariablesStyle } from '@/data/brand';
import { getMenuCategoryLabel, menuCategories } from '@/data/product-categories';
import { listActiveMenuProducts } from '@/lib/db/products';
import { getExchangeRates } from '@/lib/db/exchange-rates';
import { formatCop } from '@/lib/utils/currency';
import { getProxiedImageUrl } from '@/lib/utils/images';
import { isStoreOpen } from '@/lib/utils/schedule';
import Card from '@/components/Card.astro';
import CartDrawer from '@/components/cart/CartDrawer';
import CurrencySwitch from '@/components/currency/CurrencySwitch.astro';
import '@/styles/global.css';

const [products, exchangeRates] = await Promise.all([
  listActiveMenuProducts(),
  getExchangeRates(),
]);

const storeIsOpen = isStoreOpen(brand.contact.openingHour, brand.contact.closingHour);

const categories = menuCategories
  .map((category) => ({
    id: category.id,
    label: category.label,
    products: products
      .filter((product) => product.category === category.id)
      .sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .filter((category) => category.products.length > 0);

const hasProducts = products.length > 0;
const title = `${brand.name} | Menú`;

const isAvailableProduct = (p: (typeof products)[number]) =>
  !(p.has_inventory && p.stock !== null && p.stock !== undefined && p.stock <= 0);

const preferredHeroCategories = ['hamburguesas', 'perros-calientes', 'entradas'];
const featuredProduct =
  products.find(
    (p) =>
      isAvailableProduct(p) &&
      preferredHeroCategories.includes(p.category) &&
      Boolean(getProxiedImageUrl(p.image_url)),
  ) ??
  products.find((p) => isAvailableProduct(p) && Boolean(getProxiedImageUrl(p.image_url))) ??
  products.find((p) => isAvailableProduct(p)) ??
  products[0] ??
  null;

const featuredImageUrl = featuredProduct
  ? getProxiedImageUrl(featuredProduct.image_url)
  : null;

const highlightProducts = products
  .filter(
    (p) =>
      isAvailableProduct(p) &&
      p.id !== featuredProduct?.id &&
      p.category !== 'adicionales',
  )
  .slice(0, 3);
---

<!doctype html>
<html lang={brand.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={`${brand.name} — Menú digital de restaurante. ${brand.tagline}`}
    />
    <link rel="icon" type="image/webp" href={brand.assets.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global set:html={brandCssVariablesStyle()}></style>
  </head>
  <body>
    <!-- BARRA DE NAVEGACIÓN SUPERIOR DEL RESTAURANTE -->
    <nav class="site-nav" aria-label="Navegación principal">
      <div class="site-nav__inner">
        <a href="#top" class="site-nav__brand">
          <span class="site-nav__logo-wrap">
            <img
              src={brand.assets.logo}
              alt={brand.name}
              class="site-nav__logo"
              width={36}
              height={36}
            />
          </span>
          <span class="site-nav__brand-text">
            <span class="site-nav__brand-name">{brand.name}</span>
            <span class="site-nav__brand-sub">Carta Digital</span>
          </span>
        </a>

        <div class="site-nav__actions">
          <div
            class={`menu-hero__status ${storeIsOpen ? 'menu-hero__status--open' : 'menu-hero__status--closed'}`}
            id="store-status-badge"
            data-open-hour={brand.contact.openingHour || ''}
            data-close-hour={brand.contact.closingHour || ''}
          >
            <span
              class={`menu-hero__status-dot ${storeIsOpen ? '' : 'menu-hero__status-dot--closed'}`}
              aria-hidden="true"
            ></span>
            <span id="store-status-text">
              {storeIsOpen ? 'Abierto ahora' : 'Cerrado'}
            </span>
          </div>

          <CurrencySwitch rates={exchangeRates} class="site-nav__currency" />

          <button
            type="button"
            class="site-nav__cart-btn"
            id="nav-cart-btn"
            aria-label="Abrir mi pedido"
          >
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="site-nav__cart-label">Mi pedido</span>
            <span class="site-nav__cart-badge" id="nav-cart-badge" hidden>0</span>
          </button>
        </div>
      </div>
    </nav>

    <!-- HERO CULINARIO -->
    <header class="menu-hero" id="top">
      <div class="menu-hero__ambient" aria-hidden="true"></div>
      <div class="menu-hero__inner">
        <div class="menu-hero__grid">
          <!-- COLUMNA IZQUIERDA: IDENTIDAD Y SERVICIO -->
          <div class="menu-hero__content">
            <div class="menu-hero__eyebrow">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                <path d="M7 2v20"></path>
                <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
              </svg>
              <span>Cocina fresca &bull; Pedidos en línea</span>
            </div>

            <h1 class="menu-hero__name">{brand.name}</h1>
            <p class="menu-hero__tagline">{brand.tagline}</p>

            <!-- DATOS CLAVE DEL RESTAURANTE -->
            <div class="menu-hero__meta-grid">
              {
                brand.contact.openingHour && brand.contact.closingHour && (
                  <div class="menu-hero__meta-item">
                    <span class="menu-hero__meta-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                    </span>
                    <div>
                      <span class="menu-hero__meta-label">Horario</span>
                      <span class="menu-hero__meta-val">
                        {brand.contact.openingHour} - {brand.contact.closingHour}
                      </span>
                    </div>
                  </div>
                )
              }

              {
                (brand.contact.address || brand.contact.city) && (
                  <div class="menu-hero__meta-item">
                    <span class="menu-hero__meta-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                    </span>
                    <div>
                      <span class="menu-hero__meta-label">Ubicación</span>
                      <span class="menu-hero__meta-val">
                        {[brand.contact.address, brand.contact.city]
                          .filter(Boolean)
                          .join(', ')}
                      </span>
                    </div>
                  </div>
                )
              }

              <div class="menu-hero__meta-item">
                <span class="menu-hero__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                </span>
                <div>
                  <span class="menu-hero__meta-label">Modalidad</span>
                  <span class="menu-hero__meta-val">Domicilio y Retiro</span>
                </div>
              </div>
            </div>

            <div class="menu-hero__cta-row">
              <a href="#menu-controls" class="menu-hero__cta-primary">
                <span>Explorar la carta</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 5v14M19 12l-7 7-7-7"></path>
                </svg>
              </a>
              <button
                type="button"
                class="menu-hero__cta-secondary"
                id="hero-open-cart"
              >
                <span>Ver mi pedido</span>
              </button>
            </div>
          </div>

          <!-- COLUMNA DERECHA: PLATO DESTACADO DE LA CASA -->
          <div class="menu-hero__showcase">
            {
              featuredProduct ? (
                <a
                  href={`/producto/${featuredProduct.slug || featuredProduct.id}`}
                  class="hero-dish"
                  aria-label={`Ver plato recomendado: ${featuredProduct.name}`}
                >
                  <div class="hero-dish__media">
                    {featuredImageUrl ? (
                      <img
                        src={featuredImageUrl}
                        alt={featuredProduct.name}
                        class="hero-dish__img"
                        loading="eager"
                      />
                    ) : (
                      <div class="hero-dish__placeholder" aria-hidden="true">
                        <span class="hero-dish__placeholder-letter">
                          {featuredProduct.name.trim().charAt(0).toUpperCase()}
                        </span>
                      </div>
                    )}
                    <div class="hero-dish__overlay" aria-hidden="true"></div>
                    <span class="hero-dish__tag">Recomendado de la casa</span>
                  </div>

                  <div class="hero-dish__body">
                    <div class="hero-dish__top">
                      <span class="hero-dish__category">
                        {getMenuCategoryLabel(featuredProduct.category)}
                      </span>
                      <span
                        class="hero-dish__price"
                        data-price-cop={featuredProduct.price}
                      >
                        {formatCop(featuredProduct.price)}
                      </span>
                    </div>
                    <h2 class="hero-dish__title">{featuredProduct.name}</h2>
                    {featuredProduct.description && (
                      <p class="hero-dish__desc">{featuredProduct.description}</p>
                    )}
                    <div class="hero-dish__action">
                      <span>Personalizar y ordenar</span>
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M12 5l7 7-7 7"></path>
                      </svg>
                    </div>
                  </div>
                </a>
              ) : (
                <div class="hero-dish hero-dish--empty">
                  <div class="hero-dish__body">
                    <span class="hero-dish__tag">Nuestra Cocina</span>
                    <h2 class="hero-dish__title">Preparando el menú de hoy</h2>
                    <p class="hero-dish__desc">
                      Muy pronto tendrás disponibles nuestros platos especiales listos para pedir.
                    </p>
                  </div>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </header>

    <!-- ACORDEÓN STICKY DE BÚSQUEDA Y CATEGORÍAS -->
    <section class="menu__controls" id="menu-controls" aria-label="Filtros del menú">
      <div class="menu__controls-inner">
        <button
          type="button"
          class="menu__accordion-toggle"
          id="menu-controls-toggle"
          aria-expanded="true"
          aria-controls="menu-controls-panel"
        >
          <span class="menu__accordion-title">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Buscar y categorías</span>
          </span>
          <span class="menu__accordion-right">
            <span class="menu__accordion-hint" id="menu-controls-hint">Ocultar</span>
            <svg class="menu__accordion-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>

        <div class="menu__controls-panel" id="menu-controls-panel">
          <div class="menu__controls-panel-inner">
            <div class="menu__search-box">
              <span class="menu__search-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                id="menu-search"
                type="search"
                placeholder="¿Qué se te antoja hoy? Busca hamburguesas, perros, bebidas..."
                aria-label="Buscar un producto en el menú"
                autocomplete="off"
              />
              <button
                type="button"
                id="menu-search-clear"
                class="menu__search-clear"
                aria-label="Limpiar búsqueda"
                hidden
              >
                &times;
              </button>
            </div>

            {
              categories.length > 0 && (
                <nav class="menu__categories" aria-label="Categorías del menú">
                  <a class="menu__category-chip menu__category-chip--active" href="#menu-sections" data-cat-link="all">
                    <span class="menu__category-name">Todo</span>
                    <span class="menu__category-count">{products.length}</span>
                  </a>
                  {categories.map((category) => (
                    <a class="menu__category-chip" href={`#${category.id}`} data-cat-link={category.id}>
                      <span class="menu__category-name">{category.label}</span>
                      <span class="menu__category-count">{category.products.length}</span>
                    </a>
                  ))}
                </nav>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <main class="menu">
      <!-- SUGERENCIAS RÁPIDAS (SE OCULTA AL BUSCAR) -->
      {
        highlightProducts.length > 0 && (
          <section class="menu-highlights" id="menu-highlights" aria-label="Sugerencias del chef">
            <div class="menu-highlights__header">
              <h2 class="menu-highlights__title">Sugerencias para hoy</h2>
              <span class="menu-highlights__sub">Elige rápido o explora por categoría</span>
            </div>
            <div class="menu-highlights__grid">
              {highlightProducts.map((item) => {
                const thumb = getProxiedImageUrl(item.image_url);
                return (
                  <a href={`/producto/${item.slug || item.id}`} class="highlight-pill">
                    <div class="highlight-pill__media">
                      {thumb ? (
                        <img src={thumb} alt={item.name} loading="lazy" />
                      ) : (
                        <span>{item.name.trim().charAt(0).toUpperCase()}</span>
                      )}
                    </div>
                    <div class="highlight-pill__info">
                      <span class="highlight-pill__cat">
                        {getMenuCategoryLabel(item.category)}
                      </span>
                      <strong class="highlight-pill__name">{item.name}</strong>
                      <span class="highlight-pill__price" data-price-cop={item.price}>
                        {formatCop(item.price)}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )
      }

      <!-- SECCIÓN SIN RESULTADOS DE BÚSQUEDA -->
      <div class="menu__no-results" id="menu-no-results" hidden>
        <div class="menu__no-results-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3>No encontramos platos que coincidan</h3>
        <p>Prueba buscando con otro término o explora las categorías del restaurante.</p>
      </div>

      <!-- LISTADO DE SECCIONES DEL MENÚ -->
      {
        !hasProducts ? (
          <div class="menu__empty">
            <div class="menu__empty-illustration">🍽️</div>
            <h3>Menú en preparación</h3>
            <p>Pronto podrás explorar y ordenar nuestras especialidades culinarias.</p>
          </div>
        ) : (
          <div class="menu__sections" id="menu-sections">
            {categories.map((category) => (
              <section class="menu-section" id={category.id} data-category>
                <header class="menu-section__header">
                  <div class="menu-section__title-group">
                    <h2 class="menu-section__title">{category.label}</h2>
                    <span class="menu-section__badge">
                      {category.products.length}{' '}
                      {category.products.length === 1 ? 'opción' : 'opciones'}
                    </span>
                  </div>
                  <div class="menu-section__line" aria-hidden="true"></div>
                </header>

                <div class="menu-grid">
                  {category.products.map((product) => (
                    <Card product={product} />
                  ))}
                </div>
              </section>
            ))}
          </div>
        )
      }
    </main>

    <!-- PIE DE PÁGINA DEL RESTAURANTE -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <img
            src={brand.assets.logo}
            alt={brand.name}
            width={44}
            height={44}
            class="site-footer__logo"
          />
          <div>
            <h3 class="site-footer__name">{brand.name}</h3>
            <p class="site-footer__tagline">{brand.tagline}</p>
          </div>
        </div>

        <div class="site-footer__cols">
          <div class="site-footer__col">
            <h4>Ubicación y Horario</h4>
            {
              (brand.contact.address || brand.contact.city) && (
                <p>
                  {[brand.contact.address, brand.contact.city, brand.contact.country]
                    .filter(Boolean)
                    .join(', ')}
                </p>
              )
            }
            {
              brand.contact.openingHour && brand.contact.closingHour && (
                <p>
                  Todos los días: {brand.contact.openingHour} - {brand.contact.closingHour}
                </p>
              )
            }
          </div>

          <div class="site-footer__col">
            <h4>Contacto</h4>
            {brand.contact.phone && <p>Tel / WhatsApp: {brand.contact.phone}</p>}
            {brand.contact.instagram && <p>Instagram: {brand.contact.instagram}</p>}
          </div>

          <div class="site-footer__col">
            <h4>Accesos</h4>
            <div class="site-footer__links">
              <a href="#menu-controls">Ver la carta</a>
              <button type="button" id="footer-open-cart" class="site-footer__link-btn">
                Mi pedido actual
              </button>
              <a href="/login">Acceso personal</a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- CARRITO / PEDIDO LATERAL REACT COMPONENT -->
    <CartDrawer
      client:load
      brandName={brand.name}
      brandPhone={brand.contact.phone}
      showFloatingButton={true}
      exchangeRates={exchangeRates}
      openingHour={brand.contact.openingHour}
      closingHour={brand.contact.closingHour}
    />

    <script>
      import {
        CART_STORAGE_KEY,
        CART_EVENT,
        openCartDrawer,
      } from '@/lib/cart';

      const search = document.getElementById('menu-search') as HTMLInputElement | null;
      const searchClear = document.getElementById('menu-search-clear') as HTMLButtonElement | null;
      const controlsToggle = document.getElementById('menu-controls-toggle') as HTMLButtonElement | null;
      const controlsPanel = document.getElementById('menu-controls-panel') as HTMLElement | null;
      const controlsHint = document.getElementById('menu-controls-hint') as HTMLElement | null;
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.menu-card'));
      const noResults = document.getElementById('menu-no-results') as HTMLElement | null;
      const highlights = document.getElementById('menu-highlights') as HTMLElement | null;
      const categoryLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]'),
      );

      // Acordeón de buscador y categorías
      function setControlsOpen(open: boolean) {
        if (!controlsToggle || !controlsPanel) return;
        controlsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        controlsPanel.classList.toggle('menu__controls-panel--collapsed', !open);
        if (controlsHint) {
          controlsHint.textContent = open ? 'Ocultar' : 'Mostrar';
        }
      }

      controlsToggle?.addEventListener('click', () => {
        const isExpanded = controlsToggle.getAttribute('aria-expanded') === 'true';
        setControlsOpen(!isExpanded);
      });

      // Botones para abrir el carrito lateral
      const navCartBtn = document.getElementById('nav-cart-btn');
      const heroOpenCart = document.getElementById('hero-open-cart');
      const footerOpenCart = document.getElementById('footer-open-cart');
      const navCartBadge = document.getElementById('nav-cart-badge');

      [navCartBtn, heroOpenCart, footerOpenCart].forEach((btn) => {
        btn?.addEventListener('click', () => openCartDrawer());
      });

      function updateNavCartBadge() {
        if (!navCartBadge) return;
        try {
          const raw = window.localStorage.getItem(CART_STORAGE_KEY);
          if (!raw) {
            navCartBadge.hidden = true;
            return;
          }
          const items = JSON.parse(raw);
          if (Array.isArray(items) && items.length > 0) {
            const count = items.reduce(
              (acc: number, item: { quantity?: number }) => acc + (Number(item.quantity) || 1),
              0,
            );
            navCartBadge.textContent = String(count);
            navCartBadge.hidden = false;
          } else {
            navCartBadge.hidden = true;
          }
        } catch {
          navCartBadge.hidden = true;
        }
      }

      window.addEventListener(CART_EVENT, updateNavCartBadge);
      window.addEventListener('storage', updateNavCartBadge);
      updateNavCartBadge();

      // Filtrado en tiempo real del menú
      function applySearchFilter() {
        if (!search) return;
        const query = search.value.trim().toLowerCase();

        if (searchClear) {
          searchClear.hidden = query.length === 0;
        }
        if (highlights) {
          highlights.hidden = query.length > 0;
        }

        cards.forEach((card) => {
          const name = card.dataset.name ?? '';
          const match = !query || name.includes(query);
          card.hidden = !match;
        });

        let visibleSectionCount = 0;
        sections.forEach((section) => {
          const visible = Array.from(
            section.querySelectorAll<HTMLElement>('.menu-card'),
          ).some((card) => !card.hidden);
          section.hidden = !visible;
          if (visible) visibleSectionCount++;
        });

        if (noResults) {
          noResults.hidden = visibleSectionCount > 0 || !query;
        }
      }

      search?.addEventListener('input', applySearchFilter);
      searchClear?.addEventListener('click', () => {
        if (!search) return;
        search.value = '';
        applySearchFilter();
        search.focus();
      });

      // Resaltar categoría activa al hacer click o scroll
      function setActiveCategoryChip(id: string) {
        categoryLinks.forEach((link) => {
          link.classList.toggle(
            'menu__category-chip--active',
            link.dataset.catLink === id,
          );
        });
      }

      categoryLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const id = link.dataset.catLink;
          if (id) setActiveCategoryChip(id);
        });
      });

      if ('IntersectionObserver' in window && sections.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.find((e) => e.isIntersecting);
            if (visible?.target.id) {
              setActiveCategoryChip(visible.target.id);
            }
          },
          { rootMargin: '-180px 0px -60% 0px', threshold: 0.05 },
        );
        sections.forEach((section) => observer.observe(section));
      }

      // Actualización reactiva del badge de estado según horario de Venezuela
      const statusBadge = document.getElementById('store-status-badge');
      const statusText = document.getElementById('store-status-text');
      const statusDot = statusBadge?.querySelector('.menu-hero__status-dot');
      const openH = statusBadge?.dataset.openHour;
      const closeH = statusBadge?.dataset.closeHour;

      function updateStatusBadge() {
        if (!statusBadge || !statusText || !openH || !closeH) return;
        const parseMinutes = (t: string) => {
          const [h, m] = t.split(':').map(Number);
          return (h || 0) * 60 + (m || 0);
        };
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Caracas',
          hour: 'numeric',
          minute: 'numeric',
          hour12: false,
        }).formatToParts(new Date());
        const hourPart = parts.find((p) => p.type === 'hour')?.value ?? '0';
        const minPart = parts.find((p) => p.type === 'minute')?.value ?? '0';
        const curMin = (parseInt(hourPart, 10) % 24) * 60 + parseInt(minPart, 10);

        const oMin = parseMinutes(openH);
        const cMin = parseMinutes(closeH);
        let open = false;
        if (oMin === cMin) open = true;
        else if (oMin < cMin) open = curMin >= oMin && curMin < cMin;
        else open = curMin >= oMin || curMin < cMin;

        if (open) {
          statusBadge.classList.add('menu-hero__status--open');
          statusBadge.classList.remove('menu-hero__status--closed');
          statusDot?.classList.remove('menu-hero__status-dot--closed');
          statusText.textContent = 'Abierto ahora';
        } else {
          statusBadge.classList.remove('menu-hero__status--open');
          statusBadge.classList.add('menu-hero__status--closed');
          statusDot?.classList.add('menu-hero__status-dot--closed');
          statusText.textContent = 'Cerrado';
        }
      }

      setInterval(updateStatusBadge, 30000);
    </script>
  </body>
