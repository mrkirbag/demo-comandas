---
import { brand, brandCssVariablesStyle } from '@/data/brand';
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = `Iniciar sesión | ${brand.name}` } = Astro.props;
---

<!doctype html>
<html lang={brand.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 1. Silencia errores no controlados inyectados por extensiones del navegador
      // (p. ej. Urban VPN Proxy con 200.js / 'M_ID') para evitar alertas falsas en consola.
      const isExtensionNoise = (err) => {
        const msg = typeof err === 'string' ? err : err?.message || '';
        const stack = err?.stack || '';
        return (
          msg.includes("reading 'M_ID'") ||
          msg.includes('M_ID') ||
          stack.includes('200.js')
        );
      };

      window.addEventListener('unhandledrejection', (event) => {
        if (isExtensionNoise(event.reason)) {
          event.preventDefault();
        }
      });

      window.addEventListener('error', (event) => {
        if (isExtensionNoise(event.error) || event.filename?.includes('200.js')) {
          event.preventDefault();
        }
      });

      // 2. Elimina atributos inyectados por extensiones del navegador
      // (p. ej. Bitdefender) antes de que React hidrate, para evitar
      // falsos positivos de "hydration mismatch".
      (() => {
        const ATTR = 'bis_skin_checked';

        const strip = (node) => {
          if (!node || node.nodeType !== 1) return;
          node.removeAttribute(ATTR);
        };

        document.querySelectorAll(`[${ATTR}]`).forEach(strip);

        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.type === 'attributes' && mutation.attributeName === ATTR) {
              strip(mutation.target);
            } else if (mutation.type === 'childList') {
              mutation.addedNodes.forEach((node) => {
                if (node.nodeType === 1) {
                  strip(node);
                  node.querySelectorAll?.(`[${ATTR}]`).forEach(strip);
                }
              });
            }
          }
        });

        observer.observe(document.documentElement, {
          attributes: true,
          childList: true,
          subtree: true,
        });
      })();
    </script>
    <link rel="icon" type="image/webp" href={brand.assets.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global set:html={brandCssVariablesStyle()}></style>
  </head>
  <body>
    <div class="auth">
      <aside class="auth__brand">
        <div class="auth__brand-overlay"></div>
        <div class="auth__brand-content">
          <img
            src={brand.assets.logo}
            alt={brand.name}
            class="auth__logo"
            width={220}
            height={220}
          />
          <h1 class="auth__name">{brand.name}</h1>
          <p class="auth__tagline">{brand.tagline}</p>
          {
            brand.contact.city && brand.contact.country && (
              <p class="auth__location">
                {brand.contact.city}, {brand.contact.country}
              </p>
            )
          }
        </div>
      </aside>

      <main class="auth__main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .auth {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  .auth__brand {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-secondary) 92%, black) 0%,
        var(--color-secondary) 45%,
        color-mix(in srgb, var(--color-primary) 35%, var(--color-secondary)) 100%
      ),
      var(--color-secondary);
    background-size: cover;
    background-position: center;
  }

  .auth__brand-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 20% 80%,
        color-mix(in srgb, var(--color-primary) 25%, transparent) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 20%,
        color-mix(in srgb, var(--color-accent) 20%, transparent) 0%,
        transparent 45%
      );
    pointer-events: none;
  }

  .auth__brand-content {
    position: relative;
    z-index: 1;
    max-width: 28rem;
    padding: 3rem;
    text-align: center;
    color: var(--color-secondary-foreground);
  }

  .auth__logo {
    width: min(12rem, 70%);
    height: auto;
    aspect-ratio: 1;
    margin: 0 auto 1.5rem;
    object-fit: contain;
    border-radius: 50%;
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 25%));
  }

  .auth__name {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .auth__tagline {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.88;
  }

  .auth__location {
    margin: 2rem 0 0;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .auth__main {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--color-background);
  }

  @media (max-width: 900px) {
    .auth {
      grid-template-columns: 1fr;
    }

    .auth__brand {
      display: none;
    }

    .auth__main {
      min-height: 100vh;
      padding: 1.5rem;
    }
  }
</style>

<script define:vars={{ loginBackground: brand.assets.loginBackground }}>
  if (loginBackground) {
    const brandPanel = document.querySelector('.auth__brand');
    if (brandPanel) {
      const image = new Image();
      image.onload = () => {
        brandPanel.style.backgroundImage = `linear-gradient(145deg, rgb(26 26 46 / 88%), rgb(26 26 46 / 72%)), url('${loginBackground}')`;
        brandPanel.style.backgroundSize = 'cover';
        brandPanel.style.backgroundPosition = 'center';
      };
      image.src = loginBackground;
    }
  }
</script>
